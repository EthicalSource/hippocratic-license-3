{
  "scripts": {
    "build": "node prepare-netlify-functions.js",
    "test": "node --test tests/**/*.js",
    "test:watch": "node --test --watch tests/**/*.js",
    "prepare": "if [ \"$HUSKY\" != \"0\" ]; then husky; fi"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "2.5.1",
    "prettier-plugin-go-template": "0.0.11"
  },
  "dependencies": {
    "html-to-text": "^10.0.0",
    "jsdom": "^26.1.0",
    "node-html-markdown": "^2.0.0"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "bracketSameLine": true,
    "overrides": [
      {
        "files": [
          "*.html"
        ],
        "options": {
          "parser": "go-template"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{js,mjs,cjs,json,css,html}": "prettier --write"
  }
}
